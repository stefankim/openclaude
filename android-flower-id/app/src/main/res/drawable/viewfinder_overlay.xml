<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Semi-transparent background inside frame -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="2dp" android:color="#CCFFFFFF" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- Corner brackets effect via shadow -->
    <item android:top="0dp" android:left="0dp" android:right="160dp" android:bottom="160dp">
        <shape android:shape="rectangle">
            <stroke android:width="4dp" android:color="#FFFFFFFF" />
            <corners android:topLeftRadius="4dp" />
        </shape>
    </item>
    <item android:top="0dp" android:left="160dp" android:right="0dp" android:bottom="160dp">
        <shape android:shape="rectangle">
            <stroke android:width="4dp" android:color="#FFFFFFFF" />
            <corners android:topRightRadius="4dp" />
        </shape>
    </item>
    <item android:top="160dp" android:left="0dp" android:right="160dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <stroke android:width="4dp" android:color="#FFFFFFFF" />
            <corners android:bottomLeftRadius="4dp" />
        </shape>
    </item>
    <item android:top="160dp" android:left="160dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <stroke android:width="4dp" android:color="#FFFFFFFF" />
            <corners android:bottomRightRadius="4dp" />
        </shape>
    </item>
</layer-list>
