<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Full-screen camera preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- Viewfinder targeting box -->
    <View
        android:id="@+id/viewfinderOverlay"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/viewfinder_overlay"
        android:layout_marginBottom="120dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Settings button (top right) -->
    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/btn_icon_bg"
        android:src="@drawable/ic_settings"
        android:contentDescription="@string/content_desc_settings"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Favorites list button (top left) -->
    <ImageButton
        android:id="@+id/favoritesListButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/btn_icon_bg"
        android:src="@drawable/ic_star_outline"
        android:contentDescription="@string/view_favorites"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Instruction label -->
    <TextView
        android:id="@+id/instructionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/instruction"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:background="#88000000"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toBottomOf="@id/viewfinderOverlay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

    <!-- Capture button (bottom center) -->
    <ImageButton
        android:id="@+id/captureButton"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/btn_capture"
        android:src="@drawable/ic_camera"
        android:contentDescription="@string/content_desc_take_photo"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Loading overlay -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_bg"
            android:padding="28dp">

            <ProgressBar
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:indeterminateTint="#4CAF50" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/identifying"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginTop="14dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Result bottom sheet -->
    <FrameLayout
        android:id="@+id/resultCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:maxHeight="560dp"
            android:background="@drawable/result_card_bg"
            android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Drag handle -->
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:background="#DDDDDD" />

            <!-- Flower photo with close button overlay -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="10dp">

                <ImageView
                    android:id="@+id/flowerImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/content_desc_plant_photo" />

                <ImageButton
                    android:id="@+id/closeResultButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp"
                    android:background="@drawable/btn_icon_bg"
                    android:src="@drawable/ic_close"
                    android:contentDescription="@string/content_desc_close" />

                <ImageButton
                    android:id="@+id/favoriteButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="10dp"
                    android:background="@drawable/btn_icon_bg"
                    android:src="@drawable/ic_star_outline"
                    android:contentDescription="@string/add_to_favorites" />
            </FrameLayout>

            <!-- Weed status banner -->
            <LinearLayout
                android:id="@+id/weedStatusBanner"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/status_banner_bg">

                <TextView
                    android:id="@+id/weedStatusIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/weedStatusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <!-- Plant common name -->
            <TextView
                android:id="@+id/plantNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:paddingHorizontal="20dp" />

            <!-- Scientific name -->
            <TextView
                android:id="@+id/scientificNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="italic"
                android:textColor="#757575"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="3dp" />

            <!-- Confidence -->
            <TextView
                android:id="@+id/confidenceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#9E9E9E"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="3dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F0F0F0"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />

            <!-- Short description (from Wikipedia) -->
            <TextView
                android:id="@+id/descriptionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#424242"
                android:lineSpacingMultiplier="1.4"
                android:paddingHorizontal="20dp"
                android:visibility="gone" />

            <!-- Link to full Wikipedia article -->
            <TextView
                android:id="@+id/learnMoreLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/learn_more"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:background="?attr/selectableItemBackground"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <!-- Weed reason -->
            <TextView
                android:id="@+id/weedReasonText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#424242"
                android:lineSpacingMultiplier="1.4"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <!-- How to remove it (weeds only) -->
            <LinearLayout
                android:id="@+id/removalCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/removal_card_bg"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/removalHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/removal_heading"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1B5E20" />

                <TextView
                    android:id="@+id/removalText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#33461F"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Scan again button -->
            <Button
                android:id="@+id/scanAgainButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/scan_again"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/garden_green"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                style="@style/Widget.Material3.Button" />
        </LinearLayout>
        </ScrollView>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
