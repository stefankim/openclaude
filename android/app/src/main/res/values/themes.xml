<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose drives the UI; the platform theme only needs to be action-bar-free
         and edge-to-edge friendly. enableEdgeToEdge() handles the system bars. -->
    <style name="Theme.WeatherRadar" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/slate900</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
